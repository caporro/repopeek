{
  "name": "repopeek",
  "productName": "RepoPeek",
  "version": "0.1.0",
  "private": true,
  "description": "Controllo repository Git, staging e commit. Locale, macOS.",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "build:ui": "tsc --noEmit && vite build",
    "build": "tauri build --no-bundle",
    "start": "node scripts/start.mjs",
    "test": "node scripts/test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "package": "tauri build --bundles app --no-sign",
    "format": "prettier --write src tests scripts *.json *.ts *.md"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
