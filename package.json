{
  "name": "repopeek",
  "productName": "RepoPeek",
  "version": "0.1.0",
  "private": true,
  "description": "Controllo repository Git, staging e commit. Locale, macOS.",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "package": "npm run build && electron-builder --mac dir",
    "format": "prettier --write ."
  },
  "build": {
    "appId": "local.repopeek.desktop",
    "productName": "RepoPeek",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
